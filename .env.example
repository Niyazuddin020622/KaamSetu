# ==========================================
# KaamSetu Enterprise Environment Variables
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/worker_finder_db

# Security & Authentication
JWT_SECRET=kaamsetu_super_secure_jwt_token_key_2026_change_in_production
ADMIN_PIN=admin123
SESSION_COOKIE_NAME=kaamsetu_session
COOKIE_SECRET=kaamsetu_cookie_secret_key_9999

# Client URLs (for CORS whitelisting with credentials)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Frontend API Configuration
VITE_LOCAL_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=/api
