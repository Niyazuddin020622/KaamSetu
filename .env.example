# ==========================================
# KaamSetu Enterprise Environment Variables
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/worker_finder_db

# Security & Authentication
JWT_SECRET=your_jwt_secret_token_secure_key
ADMIN_PIN=admin123
SESSION_COOKIE_NAME=kaamsetu_session
COOKIE_SECRET=your_cookie_secret_key_here

# Client URLs (for CORS whitelisting with credentials)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://kaamsetu06.vercel.app

# ImageKit Cloud Storage Configuration
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint/

# Frontend API Configuration
VITE_LOCAL_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=https://kaamsetu-nyud.onrender.com/api
