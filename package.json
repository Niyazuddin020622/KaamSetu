{
  "name": "kaamsetu-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "KaamSetu - India's Trusted Trade Workers Network & Admin Control Center",
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm --prefix backend install",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin-dashboard run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin-dashboard run build",
    "seed": "node backend/seed.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose exec backend node seed.js",
    "docker:dev": "docker compose -f docker-compose.dev.yml up"
  }
}
